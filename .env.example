OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
HAMC_PORT=5000
HAMC_SECRET=change-me-to-a-long-random-string
HAMC_PUBLIC_URL=http://127.0.0.1:5000

# Required on Vercel so accounts survive cold starts (do NOT use /tmp SQLite alone).
# Create a free DB at https://turso.tech then paste URL + token here AND in Vercel env.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Real account emails (welcome + delete + password reset). Example: Gmail + App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=HAM-C <your.email@gmail.com>
